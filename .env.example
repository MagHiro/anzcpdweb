# Required at runtime
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/anzcpd
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Stripe test mode
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Only for deliberate local development without Turnstile: true is rejected in production.
TURNSTILE_DEV_BYPASS=false

# Transactional email. Set EMAIL_PROVIDER=smtp for SMTP, or leave auto to select SMTP when SMTP_HOST is set.
EMAIL_PROVIDER=auto
RESEND_API_KEY=re_replace_me
EMAIL_FROM=ANZ CPD <noreply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=

# Protect the email outbox processing endpoint if you expose one through a scheduler.
EMAIL_PROCESSING_SECRET=replace-with-a-random-secret

# One-time admin bootstrap. Do not leave these configured after use.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
