# Copy this file to deploy/production.env. Never commit the copied file.

NODE_ENV=production
APP_URL=https://cpd.example.com
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# The db service uses these values. DATABASE_URL must use the Compose service name "db".
# Keep the password URL-safe, or percent-encode it in DATABASE_URL.
POSTGRES_DB=anzcpd
POSTGRES_USER=anzcpd
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://anzcpd:replace-with-a-long-random-password@db:5432/anzcpd

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Stripe live-mode configuration
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Cloudflare Turnstile production keys
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_turnstile_site_key
TURNSTILE_SECRET_KEY=replace_with_turnstile_secret_key
TURNSTILE_DEV_BYPASS=false

# Transactional email
RESEND_API_KEY=re_replace_me
EMAIL_FROM=ANZ CPD <noreply@example.com>

# Cloudflare R2 / S3-compatible object storage. Required for production uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://replace-account-id.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=

# Optional secret for a separately exposed email-processing endpoint.
EMAIL_PROCESSING_SECRET=

# Set these only for the one-time admin bootstrap, then remove them.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
